# Content Creater - Environment Variables

# LLM Configuration
LLM_API_KEY=your-anthropic-api-key
LLM_PROVIDER=claude
LLM_MODEL=claude-sonnet-4-20250514

# TTS Configuration
TTS_API_KEY=your-minimax-api-key
TTS_PROVIDER=minimax

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://content:content@localhost:5432/content_db
POSTGRES_USER=content
POSTGRES_PASSWORD=content
POSTGRES_DB=content_db

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=content-media

# App
APP_DEBUG=true
